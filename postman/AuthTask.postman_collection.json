  "item": [
    {
      "name": "Register Normal User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registration returns 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"User role is assigned\", function () {\r\n    const user = pm.response.json();\r\n    pm.expect(user.role).to.eql(\"User\");\r\n});\r\n\r\npm.test(\"Password is not exposed\", function () {\r\n    const user = pm.response.json();\r\n    pm.expect(user).to.not.have.property(\"password\");\r\n    pm.expect(user).to.not.have.property(\"passwordHash\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"fullName\": \"Sara Ahmad\",\r\n  \"email\": \"sara@example.com\",\r\n  \"password\": \"Sara12345!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:5020/api/auth/register",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "5020",
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login Normal User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login returns 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"JWT token is returned\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.token).to.be.a(\"string\");\r\n    pm.expect(response.token.split(\".\")).to.have.lengthOf(3);\r\n    pm.expect(response.tokenType).to.eql(\"Bearer\");\r\n});\r\n\r\nif (pm.response.code === 200) {\r\n    pm.collectionVariables.set(\"userToken\", pm.response.json().token);\r\n}"
            ]
          }
        }
      ],
