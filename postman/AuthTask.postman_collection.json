    {
      "name": "Get Profile With Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Profile returns 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Profile contains correct user information\", function () {\r\n    const profile = pm.response.json();\r\n\r\n    pm.expect(profile.fullName).to.eql(\"Sara Ahmad\");\r\n    pm.expect(profile.email).to.eql(\"sara@example.com\");\r\n    pm.expect(profile.role).to.eql(\"User\");\r\n});\r\n\r\npm.test(\"Profile contains user ID\", function () {\r\n    const profile = pm.response.json();\r\n\r\n    pm.expect(profile.id).to.exist;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5020/api/profile",
